{
  "version": 9,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/cmake-build/${presetName}",
      "installDir": "${sourceDir}/cmake-build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "mac-dev",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-release",
      "inherits": "mac-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-dev",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-release",
      "inherits": "win-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-dev",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac-dev",       "configurePreset": "mac-dev" },
    { "name": "mac-release",   "configurePreset": "mac-release" },
    { "name": "win-dev",       "configurePreset": "win-dev",     "configuration": "Debug" },
    { "name": "win-release",   "configurePreset": "win-release", "configuration": "Release" },
    { "name": "linux-dev",     "configurePreset": "linux-dev" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    { "name": "mac-dev",     "inherits": "test-base", "configurePreset": "mac-dev" },
    { "name": "mac-release", "inherits": "test-base", "configurePreset": "mac-release" },
    { "name": "win-dev",     "inherits": "test-base", "configurePreset": "win-dev",   "configuration": "Debug" },
    { "name": "win-release", "inherits": "test-base", "configurePreset": "win-release", "configuration": "Release" },
    { "name": "linux-dev",     "inherits": "test-base", "configurePreset": "linux-dev" },
    { "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" }
  ]
}
