{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/cmake-build/${presetName}",
      "installDir": "${sourceDir}/cmake-build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "mac-dev",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-release",
      "inherits": "mac-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-dev",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-release",
      "inherits": "win-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-dev",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "configurePreset": "base",
      "jobs": 8,
      "inheritConfigureEnvironment": true
    },
    {
      "name": "build-mac-dev",
      "configurePreset": "mac-dev",
      "inherits": "build-base",
      "configuration": "Debug",
      "verbose": true
    },
    { "name": "build-mac-release",
      "configurePreset": "mac-release",
      "inherits": "build-base",
      "verbose": false,
      "configuration": "Release",
      "cleanFirst": true
    },
    {
      "name": "build-win-dev",
      "configurePreset": "win-dev",
      "configuration": "Debug",
      "verbose": true,
      "inherits": "build-base"
    },
    {
      "name": "build-win-release",
      "configurePreset": "win-release",
      "configuration": "Release",
      "verbose": false,
      "inherits": "build-base",
      "cleanFirst": true
    },
    {
      "name": "build-linux-dev",
      "configurePreset": "linux-dev"
    },
    {
      "name": "build-linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "test-mac-dev",
      "inherits": "test-base",
      "configurePreset": "mac-dev"
    },
    { "name": "test-mac-release", "inherits": "test-base", "configurePreset": "mac-release" },
    { "name": "test-win-dev",     "inherits": "test-base", "configurePreset": "win-dev",   "configuration": "Debug" },
    { "name": "test-win-release", "inherits": "test-base", "configurePreset": "win-release", "configuration": "Release" },
    { "name": "test-linux-dev",     "inherits": "test-base", "configurePreset": "linux-dev" },
    { "name": "test-linux-release", "inherits": "test-base", "configurePreset": "linux-release" }
  ],
  "packagePresets": [
    {
      "name": "pack-base",
      "hidden": true,
      "configurePreset": "base",
      "packageDirectory": "${sourceDir}/dist"
    },
    {
      "name": "pack-mac-release",
      "inherits": "pack-base",
      "configurePreset": "mac-release",
      "generators": ["TGZ"]
    },
    {
      "name": "pack-win-release",
      "inherits": "pack-base",
      "configurePreset": "win-release",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "pack-linux-release",
      "inherits": "pack-base",
      "configurePreset": "linux-release",
      "generators": ["TGZ"]
    }
  ]
}
