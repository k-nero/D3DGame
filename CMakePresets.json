{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "mac-dev",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-dev",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "win-release",
      "inherits": "win-dev"
    }
  ],
  "buildPresets": [
    { "name": "mac-dev", "configurePreset": "mac-dev" },
    { "name": "win-dev", "configurePreset": "win-dev", "configuration": "Debug" },
    { "name": "win-release", "configurePreset": "win-release", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "mac-dev", "configurePreset": "mac-dev", "output": { "outputOnFailure": true } },
    { "name": "win-dev", "configurePreset": "win-dev", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
